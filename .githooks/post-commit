#!/bin/sh
# post-commit: refresh the AI context git-state snapshot after each commit, and
# recalibrate CODEX.md line numbers only when tracked C# sources changed.

ROOT=$(git rev-parse --show-toplevel)

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ROOT/AI_Script/refresh_state.ps1"

if git diff-tree --no-commit-id --name-only -r HEAD |
    grep -Eq '^(ExcelDiff/|ExcelDiff\.GUI/|NetDiff/NetDiff/|FastWpfGrid/).*\.cs$'; then
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ROOT/AI_Script/refresh_codex.ps1"
fi
