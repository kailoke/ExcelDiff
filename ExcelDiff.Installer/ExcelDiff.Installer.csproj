    <OutputType>WinExe</OutputType>
    <RootNamespace>ExcelDiff.Setup</RootNamespace>
    <AssemblyName>ExcelDiffSetup</AssemblyName>
    <TargetFramework>net472</TargetFramework>
    <FrameworkPathOverride>$(MSBuildThisFileDirectory)..\packages\refs\.NETFramework\v4.7.2</FrameworkPathOverride>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
