    <EmbeddedResource Include="Strings\en-US.txt" LogicalName="ExcelDiff.Setup.Strings.en-US.txt" />
    <!-- The app payload is zipped by Build-Setup.ps1 right before this project is built.
         It stays optional so a plain solution build still compiles; the installer then
         fails with a clear "payload missing" message instead of breaking the gate. -->
    <EmbeddedResource Include="obj\payload.zip" LogicalName="ExcelDiff.Setup.Payload.zip"
                      Condition="Exists('$(MSBuildProjectDirectory)\obj\payload.zip')" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.manifest" />
    <None Include="Build-Setup.ps1" />
  </ItemGroup>
