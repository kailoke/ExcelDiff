<Window x:Class="ExcelDiff.Setup.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="470"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHe UI, Segoe UI, Malgun Gothic"
        FontSize="13"
        Background="White">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="#F3F3F3" BorderBrush="#D9D9D9" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" Foreground="#202020" />
                <TextBlock x:Name="StepText" Margin="0,4,0,0" Foreground="#666666" />
            </StackPanel>
        </Border>

        <!-- body: one panel per step, toggled by code -->
        <Grid Grid.Row="1" Margin="20,16,20,8">

            <StackPanel x:Name="LanguagePanel">
                <TextBlock x:Name="LanguagePrompt" TextWrapping="Wrap" Margin="0,0,0,16" />
                <RadioButton x:Name="ChineseOption" Margin="0,4" Checked="OnLanguageChosen" Tag="zh-CN" />
                <RadioButton x:Name="EnglishOption" Margin="0,4" Checked="OnLanguageChosen" Tag="en-US" />
                <TextBlock x:Name="LanguageNote" Margin="0,16,0,0" Foreground="#666666" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="LocationPanel" Visibility="Collapsed">
                <TextBlock x:Name="LocationPrompt" TextWrapping="Wrap" Margin="0,0,0,12" />
                <DockPanel LastChildFill="True">
                    <Button x:Name="BrowseButton" DockPanel.Dock="Right" Margin="8,0,0,0"
                            Padding="12,4" Click="OnBrowse" />
                    <TextBox x:Name="DirBox" VerticalContentAlignment="Center" Padding="4" />
                </DockPanel>
                <TextBlock x:Name="UpgradeNotice" Margin="0,12,0,0" Foreground="#A34A00" TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <TextBlock x:Name="ComponentsTitle" Margin="0,20,0,6" FontWeight="SemiBold" />
                <CheckBox x:Name="ShellCheck" Margin="0,3" />
                <CheckBox x:Name="DesktopCheck" Margin="0,3" />
                <CheckBox x:Name="AutoStartCheck" Margin="0,3" />
                <TextBlock x:Name="LocationNote" Margin="0,16,0,0" Foreground="#666666" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                <TextBlock x:Name="ConfirmPrompt" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock x:Name="ConfirmSummary" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI" />
                <TextBlock x:Name="ConfirmNote" Margin="0,16,0,0" Foreground="#666666" TextWrapping="Wrap" />
            </StackPanel>

            <Grid x:Name="ProgressPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ProgressPrompt" Grid.Row="0" Margin="0,0,0,10" />
                <ProgressBar x:Name="Progressbar" Grid.Row="1" Height="14" Minimum="0" Maximum="100" />
                <ScrollViewer x:Name="LogScroll" Grid.Row="2" Margin="0,12,0,0"
                              BorderBrush="#DDDDDD" BorderThickness="1" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" FontFamily="Consolas"
                             FontSize="11.5" TextWrapping="NoWrap" Background="#FAFAFA" />
                </ScrollViewer>
            </Grid>

            <StackPanel x:Name="FinishPanel" Visibility="Collapsed">
                <TextBlock x:Name="FinishPrompt" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="FinishHowTo" Margin="0,14,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="FinishTray" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="FinishLog" Margin="0,14,0,0" Foreground="#666666" TextWrapping="Wrap" />
                <TextBlock x:Name="FinishError" Margin="0,14,0,0" Foreground="#B00000" TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- footer -->
        <Border Grid.Row="2" Background="#F7F7F7" BorderBrush="#D9D9D9" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Button x:Name="CancelButton" HorizontalAlignment="Left" MinWidth="88" Padding="10,4"
                        Click="OnCancel" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="BackButton" MinWidth="88" Margin="0,0,8,0" Padding="10,4" Click="OnBack" />
                    <Button x:Name="NextButton" MinWidth="96" Padding="10,4" IsDefault="True" Click="OnNext" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
