  <Target Name="EnsureNetStandardForMarkupCompile" BeforeTargets="MarkupCompilePass1">
    <!-- The WPF markup compiler (MarkupCompilePass1) loads references via @(ReferencePath)
         and ResolveAssemblyReferences drops 'netstandard' from it for net472. Stage the
         netstandard 2.0.0.0 *bridge* assembly that ships with the .NET SDK build extensions
         (net461\lib) and add it back to ReferencePath so the XAML compiler can resolve packages
         carrying netstandard2.0 assemblies (e.g. System.Runtime.CompilerServices.Unsafe). The
         bridge forwards netstandard types to mscorlib, avoiding CS0433 duplicate-attribute
         conflicts that the standalone ref\netstandard.dll would cause in the temp markup project. -->
    <Copy SourceFiles="$(MSBuildBinPath)Microsoft\Microsoft.NET.Build.Extensions\net461\lib\netstandard.dll"
          DestinationFiles="$(FrameworkPathOverride)\netstandard.dll"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildBinPath)Microsoft\Microsoft.NET.Build.Extensions\net461\lib\netstandard.dll')" />
    <ItemGroup>
      <ReferencePath Include="$(FrameworkPathOverride)\netstandard.dll" />
    </ItemGroup>
  </Target>
