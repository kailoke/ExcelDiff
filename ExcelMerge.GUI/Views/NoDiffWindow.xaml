<Window x:Class="ExcelMerge.GUI.Views.NoDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:props="clr-namespace:ExcelMerge.GUI.Properties"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="400"
        Background="White"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Loaded="NoDiffWindow_Loaded"
        PreviewKeyDown="NoDiffWindow_PreviewKeyDown">
  <Window.Resources>
    <Style x:Key="CloseXButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    CornerRadius="4"
                    Background="Transparent"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#59FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="#FF43A047"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid>
        <TextBlock x:Name="TitleText"
                   Foreground="White"
                   FontSize="15"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0"/>
        <Button x:Name="CloseButton"
                Style="{StaticResource CloseXButtonStyle}"
                Content="&#x2715;"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                Click="CloseButton_Click"/>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Margin="28,24,28,24">
      <TextBlock x:Name="MessageText"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 FontSize="14"
                 Foreground="#FF333333"/>

      <StackPanel x:Name="ButtonsRow"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  Margin="0,24,0,0">
        <Button x:Name="CloseResultButton"
                Content="{x:Static props:Resources.Word_Exit}"
                Background="#FFFF8A80"
                Foreground="White"
                BorderThickness="0"
                FontSize="14"
                FontWeight="Bold"
                Width="200"
                Height="38"
                Margin="0,24,0,0"
                IsDefault="True"
                Click="CloseResultButton_Click"
                Cursor="Hand"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
